# SPSAAS API - Variables de entorno
# Copiar a .env y ajustar valores

# Entorno
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Base de datos (PostgreSQL + TimescaleDB con asyncpg)
DATABASE_URL=postgresql+asyncpg://spsaas:spsaas@localhost:5432/spsaas

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET=dev-secret-change-me-32-chars-minimum-length
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys (agentes)
API_KEY_PREFIX=spsk_
API_KEY_HASH_ALGORITHM=bcrypt

# Multi-tenant
TENANT_HEADER=X-Tenant-Slug
TENANT_COOKIE=tenant_slug

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000