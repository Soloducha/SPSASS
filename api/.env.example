# SPSAAS API - Variables de entorno
# Copiar a .env y ajustar valores

# Entorno
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Base de datos (PostgreSQL + TimescaleDB con asyncpg)
DATABASE_URL=postgresql+asyncpg://spsaas:spsaas@localhost:5432/spsaas

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET=dev-secret-change-me-32-chars-minimum-length
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys (agentes)
API_KEY_PREFIX=spsk_
API_KEY_HASH_ALGORITHM=bcrypt

# Multi-tenant
TENANT_HEADER=X-Tenant-Slug
TENANT_COOKIE=tenant_slug

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP (Email delivery for alerts)
# Email is enabled only when both SMTP_HOST and SMTP_FROM are set (non-empty)
SMTP_HOST=                    # SMTP server host (e.g., smtp.example.com)
SMTP_PORT=587                 # SMTP server port (default 587; STARTTLS submission port; implicit TLS on 465 not supported)
SMTP_USER=                    # SMTP username (empty = no authentication)
SMTP_PASSWORD=                # SMTP password (empty = no authentication)
SMTP_FROM=                    # From email address (e.g., alerts@example.com; empty = email disabled)
SMTP_STARTTLS=true            # Use STARTTLS (true/false; default true)

# Telegram (alert delivery)
# Telegram is enabled only when TELEGRAM_BOT_TOKEN is set (non-empty).
# Create a bot with @BotFather to obtain the token.
# The per-rule config supplies chat_id (and optionally thread_id, silent).
TELEGRAM_BOT_TOKEN=<paste-your-token-from-BotFather-here>           # Bot token from @BotFather (empty = telegram delivery disabled)
TELEGRAM_API_BASE=https://api.telegram.org   # Bot API base URL
TELEGRAM_MAX_MESSAGE_CHARS=4096              # Hard API limit; longer alerts are replaced by a dashboard pointer

# Public dashboard base URL. Used to link out from truncated alert messages.
# Leave empty to omit the link.
PUBLIC_DASHBOARD_URL=         # e.g., https://spsaas.example.com